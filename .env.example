# Copy to .env.local and fill in before deploying.

# Canonical site URL (no trailing slash). Used for SEO, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense publisher id, e.g. ca-pub-1234567890123456
# Leave empty to render labelled ad placeholders during development.
NEXT_PUBLIC_ADSENSE_CLIENT=
